# Copy this file to `.env` and adjust.
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (Linux / cPanel)
#
# `.env` is git-ignored, so each machine keeps its own. The application runs
# without one -- the defaults in config/settings.py are the local-development
# values -- but a public host should always have it.

# Generate a key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-50-character-random-string

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Dhaka

# ---------------------------------------------------------------------------
# Database
#
#   sqlite  -> no server to install, no configuration. Just works, and is what
#              the shared host uses.
#   mysql   -> needs MySQL 5.7+ running (MariaDB 10.2+), plus
#              `pip install -r requirements-mysql.txt`.
# ---------------------------------------------------------------------------
DB_ENGINE=sqlite

# Absolute path is safest under Passenger, whose working directory is not
# always the project root. Leave blank to use <project>/db.sqlite3.
# SQLITE_NAME=/home/CPANEL_USER/pos.odelltech.com/db.sqlite3

# Only used when DB_ENGINE=mysql
DB_NAME=pos_system
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------------------------------------------------------------------------
# Production example (cPanel / pos.odelltech.com)
#
# Copy the block below over the values above on the server, and put a real
# generated key in DJANGO_SECRET_KEY. The fallback key in settings.py is
# visible to anyone who can read the repository, so it must not be used on a
# public host.
#
#   DJANGO_SECRET_KEY=<generated>
#   DJANGO_DEBUG=False
#   DJANGO_ALLOWED_HOSTS=pos.odelltech.com,www.pos.odelltech.com
#   DJANGO_TIME_ZONE=Asia/Dhaka
#   DJANGO_BEHIND_TLS_PROXY=True
#   DB_ENGINE=sqlite
#   SQLITE_NAME=/home/CPANEL_USER/pos.odelltech.com/db.sqlite3
#
# The administrator account is created by `manage.py ensure_admin` during
# deployment. Override its credentials here if you do not want the defaults:
#
#   ADMIN_EMAIL=odelltech@gmail.com
#   ADMIN_PASSWORD=<something only you know>
# ---------------------------------------------------------------------------
