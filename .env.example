# Copy this file to `.env` and adjust.
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (Linux/macOS)

# Generate a key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-50-character-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Dhaka

# ---------------------------------------------------------------------------
# Database
#
#   sqlite  -> no server to install, no configuration. Just works.
#   mysql   -> needs MySQL 8.0.11+ running (MariaDB must be 10.11+).
#              XAMPP's bundled MariaDB 10.4 will NOT work with Django 6.1.
# ---------------------------------------------------------------------------
DB_ENGINE=sqlite

# Only used when DB_ENGINE=mysql
DB_NAME=pos_system
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
